RewriteEngine On

# 1. Ako player traži /playlist, tiho ga preusmjeri na playlist.php i prenesi parametre
RewriteRule ^playlist$ playlist.php [L,QSA]

# 2. Isključivanje sigurnosnih provjera koje bi mogle blokirati IPTV playere
<IfModule mod_headers.co>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, OPTIONS"
    Header set Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept, User-Agent"
</IfModule>
